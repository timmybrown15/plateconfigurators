screen2 = tk.Frame(root)
title2 = tk.Label(
    screen2,
    text="🏋Stack It!",
    font=("Times New Roman", 24))
title2.pack(pady=30)

#Graphic Screen
canvas2 = tk.Canvas(screen2, width=500, height=180, bg="white")
canvas2.pack(pady=10)

#Add Bar Dropdown
bar_choice2 = tk.StringVar(screen2)
bar_choice2.set("Select Bar")
bar_menu2 = tk.OptionMenu(screen2,bar_choice2,
    "Standard Barbell",                    
    "EZ Curl Bar",
    "Trap Bar")
bar_menu2.pack()

bar_choice2.trace_add("write", lambda *args: update_screen2_bar())

#Checks to See if Bar Selected
def bar_selected():
    return bar_choice2.get() in [
        "Standard Barbell",
        "EZ Curl Bar",
        "Trap Bar"]

#Clear Existing Graphic and Draw New Bar
def update_screen2_bar():
    #Clear Graphic
    canvas2.delete("all")

    #Clear Plate Count
    for plate in plates_screen2:
        plates_screen2[plate]=0
        
    #Clear Text Output
    listed_weights.config(text="")
    total_weight.config(text="")

    selected_bar2 = bar_choice2.get()
    config = BAR_DATA.get(selected_bar2)

    if not config:
        return

    config["draw"](canvas2)

#Plate Picking Interface
plate_menu = tk.Frame(screen2)
plate_menu.pack(pady=10)

#Initialize Plate Values
plates_screen2 = {
    "45": 0,
    "25": 0,
    "10": 0,
    "5": 0,
    "2.5": 0}

#Create and Format Add Plate Buttons and Remove Plate Buttons
plate_buttons = [
    ("45", "red"),
    ("25", "blue"),
    ("10", "yellow"),
    ("5", "green"),
    ("2.5", "gray")]

for plate, color in plate_buttons:

    plate_frame = tk.Frame(plate_menu)
    plate_frame.pack(side="left", padx=5)
    
    add_btn = tk.Button(
        plate_frame,
        text=f"{plate} lb",
        bg=color,
        fg="white" if plate != "10" else "black",
        width=8,
        command=lambda p=plate: add_plate(p))
    add_btn.pack(pady=5)
    
    remove_btn = tk.Button(
        plate_frame,
        text="Remove",
        bg="lightgray",
        width=8,
        command=lambda p=plate: remove_plate(p))
    remove_btn.pack()

#Count Plates Everytime a Plate Button is Pressed
def add_plate(plate):
    if not bar_selected():
        listed_weights.config(text="Choose Bar First")
        return
        
    plates_screen2[plate] += 1
    update_selection_display()
    update_total_weight()

    canvas2.delete("plates")
    canvas2.delete("legend")
    
    draw_configured_plates(canvas2, plates_screen2)
    draw_legend(canvas2, plates_screen2)

    #Saves New Data to 'SHARED_DATA' Library
    SHARED_DATA["screen2_plates"] = plates_screen2.copy()
    
    

#Remove Plates when Remove Button is Pressed
def remove_plate(plate):
    if plates_screen2[plate] > 0:
        plates_screen2[plate] -= 1
        
    update_selection_display()
    update_total_weight()

    canvas2.delete("plates")
    canvas2.delete("legend")
    
    draw_configured_plates(canvas2, plates_screen2)
    draw_legend(canvas2, plates_screen2)

    #Saves New Data to 'SHARED_DATA" Library
    SHARED_DATA["screen2_plates"] = plates_screen2.copy()
    

    
#Updates the Weight List at Bottom    
listed_weights = tk.Label(screen2, text="")
listed_weights.pack()
def update_selection_display():
    text = ""
    for plate, count in plates_screen2.items():
        if count > 0:
            text += f"{count} x {plate} lb\n"
    listed_weights.config(text=text)
    
#Outputs the Total Weight at the Bottom
total_weight = tk.Label(screen2,text="")
total_weight.pack()
def update_total_weight():
    bar = bar_choice2.get()
    config = BAR_DATA.get(bar)

    bar_weight = config["weight"] if config else 0
    
    total = 0
    for plate, count in plates_screen2.items():
        if count > 0:
           total += (float(plate) * count * 2) 
    total += bar_weight
    total_weight.config(text=f"{int(total)} lbs")
        

#Adds Toggle to Screen 1 Button
toggle2 = tk.Button(
    screen2,
    text="Switch Back",
    command=switch_screen_1or2
)
toggle2.pack(side="bottom", pady=20)

#Switch to Plot Screen Button
plot_screen_btn2 = tk.Button(
    screen2,
    text="Plot It!",
    command=go_to_screen3_from_2
)
plot_screen_btn2.place(relx=1.0, rely=1.0, x= -20, y= -20, anchor="se")

