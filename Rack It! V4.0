screen3 = tk.Frame(root)

content_frame = tk.Frame(screen3)
content_frame.place(relx=0.5, rely=0.5, anchor="center")

#Scroll Feature
scroll_canvas = tk.Canvas(content_frame, width=540, height=650)
scroll_canvas.pack(side="left", fill="y")

scrollbar = tk.Scrollbar(content_frame,orient="vertical",command=scroll_canvas.yview)
scrollbar.pack(side="right", fill="y")
scroll_canvas.configure(yscrollcommand=scrollbar.set)

scrollable_frame = tk.Frame(scroll_canvas)
scroll_canvas.create_window((0, 0), window=scrollable_frame, anchor="n")
scrollable_frame.bind(
    "<Configure>",
    lambda e: scroll_canvas.configure(
        scrollregion=scroll_canvas.bbox("all")))
scroll_canvas.bind_all(
    "<MouseWheel>",
    lambda e: scroll_canvas.yview_scroll(
        int(-1 * (e.delta / 120)),
        "units"))


title3 = tk.Label(
    scrollable_frame,
    text="📈 Plot It!",
    font=("Times New Roman", 24))
title3.pack(pady=10)

canvas3 = tk.Canvas(scrollable_frame, width=500, height=180, bg="white")
canvas3.pack(pady=10)

shear_label = tk.Label(
    scrollable_frame,
    text="Shear Force Plot",
    font=("Times New Roman", 16))
shear_label.pack(pady=10)

canvas_Shear = tk.Canvas(scrollable_frame, width=500, height=180, bg="white")
canvas_Shear.pack(pady=10)

moment_label = tk.Label(
    scrollable_frame,
    text="Bending Moment Plot",
    font=("Times New Roman", 16))
moment_label.pack(pady=10)

canvas_Moment = tk.Canvas(scrollable_frame, width=500, height=180, bg="white")
canvas_Moment.pack(pady=10)

deflection_label = tk.Label(
    scrollable_frame,
    text="Deflection Plot",
    font=("Times New Roman", 16))
deflection_label.pack(pady=10)

canvas_Deflection = tk.Canvas(scrollable_frame, width=500, height=180, bg="white")
canvas_Deflection.pack(pady=10)



go_back_btn = tk.Button(
    scrollable_frame,
    text="Go Back!",
    command=go_back
)
go_back_btn.pack(pady=20)

#================================================================================================================================================
#Start on screen 1
show_screen1()

#Keep Window Open
root.mainloop()
