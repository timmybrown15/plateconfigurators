def configurate(weight, bar): 

    x = (weight - bar) / 2
    fortyfives = (x // 45)
    x = x - (fortyfives * 45)
    twentyfives = (x // 25)
    x = x - (twentyfives * 25)
    tens = (x // 10)
    x = x - (tens * 10)
    fives = (x // 5)
    x = x - (fives * 5)
    twopointfives = (x // 2.5)
    x = x - (twopointfives * 2.5)
    remainder = x
    rack = [fortyfives, twentyfives, tens, fives, twopointfives, remainder]
    rack = [x * 2 for x in rack]
    return rack

